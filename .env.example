# Django secret key. Generate with:
# python -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(64)))"
SECRET_KEY=

# Never True in production
DEBUG=True

# Postgres connection. HOST=db inside Docker, localhost outside
POSTGRES_DB=urdp
POSTGRES_USER=urdp
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432