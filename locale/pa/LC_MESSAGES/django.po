#: intake/forms.py:10
msgid ""
"I understand that submitting this form does not create an attorney-client "
"relationship."
msgstr ""
"ਮੈਂ ਸਮਝਦਾ/ਸਮਝਦੀ ਹਾਂ ਕਿ ਇਸ ਫਾਰਮ ਨੂੰ ਜਮ੍ਹਾਂ ਕਰਨ ਨਾਲ ਵਕੀਲ-ਮੁਵੱਕਿਲ ਸੰਬੰਧ ਨਹੀਂ ਬਣਦਾ।"

#: intake/forms.py:15
msgid "Please acknowledge this notice before submitting your intake."
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਆਪਣੀ ਅਰਜ਼ੀ ਜਮ੍ਹਾਂ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਇਸ ਨੋਟਿਸ ਨੂੰ ਸਵੀਕਾਰ ਕਰੋ।"

#: intake/forms.py:41
msgid "Full name"
msgstr "ਪੂਰਾ ਨਾਮ"

#: intake/forms.py:42
msgid "Date of birth"
msgstr "ਜਨਮ ਤਾਰੀਖ"

#: intake/forms.py:43
msgid "Country of origin"
msgstr "ਮੂਲ ਦੇਸ਼"

#: intake/forms.py:44
msgid "Preferred language"
msgstr "ਪਸੰਦੀਦਾ ਭਾਸ਼ਾ"

#: intake/forms.py:45
msgid "Phone number"
msgstr "ਫ਼ੋਨ ਨੰਬਰ"

#: intake/forms.py:46
msgid "Email address"
msgstr "ਈਮੇਲ ਪਤਾ"

#: intake/forms.py:47
msgid "Current city or location"
msgstr "ਮੌਜੂਦਾ ਸ਼ਹਿਰ ਜਾਂ ਸਥਾਨ"

#: intake/forms.py:48
msgid "Currently detained"
msgstr "ਵਰਤਮਾਨ ਵਿੱਚ ਨਜ਼ਰਬੰਦ"

#: intake/forms.py:49
msgid "Immigration court"
msgstr "ਇਮੀਗ੍ਰੇਸ਼ਨ ਅਦਾਲਤ"

#: intake/forms.py:50
msgid "A-number"
msgstr "A-ਨੰਬਰ"

#: intake/forms.py:51
msgid "Next hearing date"
msgstr "ਅਗਲੀ ਸੁਣਵਾਈ ਦੀ ਤਾਰੀਖ"

#: intake/forms.py:52
msgid "Reason for fearing return"
msgstr "ਵਾਪਸੀ ਤੋਂ ਡਰਨ ਦਾ ਕਾਰਨ"

#: intake/forms.py:53
msgid "Past harm or persecution"
msgstr "ਪਿਛਲਾ ਨੁਕਸਾਨ ਜਾਂ ਅਤਿਆਚਾਰ"

#: intake/forms.py:55
msgid "Countries traveled through and asylum applications"
msgstr "ਜਿਨ੍ਹਾਂ ਦੇਸ਼ਾਂ ਵਿੱਚੋਂ ਦੀ ਲੰਘੇ ਅਤੇ ਸ਼ਰਣ ਅਰਜ਼ੀਆਂ"

#: intake/forms.py:57
msgid "Family members included"
msgstr "ਸ਼ਾਮਲ ਪਰਿਵਾਰਕ ਮੈਂਬਰ"

#: intake/forms.py:63
msgid "Enter your full name"
msgstr "ਆਪਣਾ ਪੂਰਾ ਨਾਮ ਦਰਜ ਕਰੋ"

#: intake/forms.py:77
msgid "Country where you are from"
msgstr "ਉਹ ਦੇਸ਼ ਜਿੱਥੋਂ ਤੁਸੀਂ ਹੋ"

#: intake/forms.py:84
msgid "Language you prefer for communication"
msgstr "ਸੰਚਾਰ ਲਈ ਤੁਹਾਡੀ ਪਸੰਦੀਦਾ ਭਾਸ਼ਾ"

#: intake/forms.py:91
msgid "Best phone number to reach you"
msgstr "ਤੁਹਾਡੇ ਨਾਲ ਸੰਪਰਕ ਕਰਨ ਲਈ ਸਭ ਤੋਂ ਵਧੀਆ ਫ਼ੋਨ ਨੰਬਰ"

#: intake/forms.py:99
msgid "Email address, if available"
msgstr "ਈਮੇਲ ਪਤਾ, ਜੇ ਉਪਲਬਧ ਹੋਵੇ"

#: intake/forms.py:107
msgid "City, state, or detention facility"
msgstr "ਸ਼ਹਿਰ, ਰਾਜ, ਜਾਂ ਨਜ਼ਰਬੰਦੀ ਸਹੂਲਤ"

#: intake/forms.py:115
msgid "Court name or city, if known"
msgstr "ਅਦਾਲਤ ਦਾ ਨਾਮ ਜਾਂ ਸ਼ਹਿਰ, ਜੇ ਪਤਾ ਹੋਵੇ"

#: intake/forms.py:121
msgid "Example: A123456789"
msgstr "ਉਦਾਹਰਨ: A123456789"

#: intake/forms.py:131
msgid "Describe why returning would be unsafe for you."
msgstr "ਦੱਸੋ ਕਿ ਵਾਪਸ ਜਾਣਾ ਤੁਹਾਡੇ ਲਈ ਕਿਉਂ ਅਸੁਰੱਖਿਅਤ ਹੋਵੇਗਾ।"

#: intake/forms.py:139
msgid "Describe any past harm, threats, or persecution."
msgstr "ਕਿਸੇ ਵੀ ਪਿਛਲੇ ਨੁਕਸਾਨ, ਧਮਕੀਆਂ, ਜਾਂ ਅਤਿਆਚਾਰ ਦਾ ਵਰਣਨ ਕਰੋ।"

#: intake/forms.py:148
msgid "List countries traveled through and whether you applied for asylum."
msgstr "ਉਨ੍ਹਾਂ ਦੇਸ਼ਾਂ ਦੀ ਸੂਚੀ ਬਣਾਓ ਜਿਨ੍ਹਾਂ ਵਿੱਚੋਂ ਲੰਘੇ ਅਤੇ ਦੱਸੋ ਕਿ ਕੀ ਤੁਸੀਂ ਸ਼ਰਣ ਲਈ ਅਰਜ਼ੀ ਦਿੱਤੀ।"

#: intake/forms.py:164
msgid "This information is required."
msgstr "ਇਹ ਜਾਣਕਾਰੀ ਲਾਜ਼ਮੀ ਹੈ।"

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:30
