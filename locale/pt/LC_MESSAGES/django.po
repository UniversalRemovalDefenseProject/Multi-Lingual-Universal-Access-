#: intake/forms.py:10
msgid ""
"I understand that submitting this form does not create an attorney-client "
"relationship."
msgstr ""
"Entendo que o envio deste formulário não cria uma relação de advogado-cliente."

#: intake/forms.py:15
msgid "Please acknowledge this notice before submitting your intake."
msgstr "Por favor, confirme este aviso antes de enviar sua solicitação."

#: intake/forms.py:41
msgid "Full name"
msgstr "Nome completo"

#: intake/forms.py:42
msgid "Date of birth"
msgstr "Data de nascimento"

#: intake/forms.py:43
msgid "Country of origin"
msgstr "País de origem"

#: intake/forms.py:44
msgid "Preferred language"
msgstr "Idioma preferido"

#: intake/forms.py:45
msgid "Phone number"
msgstr "Número de telefone"

#: intake/forms.py:46
msgid "Email address"
msgstr "Endereço de e-mail"

#: intake/forms.py:47
msgid "Current city or location"
msgstr "Cidade ou localização atual"

#: intake/forms.py:48
msgid "Currently detained"
msgstr "Atualmente detido(a)"

#: intake/forms.py:49
msgid "Immigration court"
msgstr "Tribunal de imigração"

#: intake/forms.py:50
msgid "A-number"
msgstr "Número A"

#: intake/forms.py:51
msgid "Next hearing date"
msgstr "Data da próxima audiência"

#: intake/forms.py:52
msgid "Reason for fearing return"
msgstr "Motivo do temor de retorno"

#: intake/forms.py:53
msgid "Past harm or persecution"
msgstr "Danos ou perseguição anteriores"

#: intake/forms.py:55
msgid "Countries traveled through and asylum applications"
msgstr "Países pelos quais viajou e pedidos de asilo"

#: intake/forms.py:57
msgid "Family members included"
msgstr "Membros da família incluídos"

#: intake/forms.py:63
msgid "Enter your full name"
msgstr "Digite seu nome completo"

#: intake/forms.py:77
msgid "Country where you are from"
msgstr "País de onde você vem"

#: intake/forms.py:84
msgid "Language you prefer for communication"
msgstr "Idioma que você prefere para comunicação"

#: intake/forms.py:91
msgid "Best phone number to reach you"
msgstr "Melhor número de telefone para contato"

#: intake/forms.py:99
msgid "Email address, if available"
msgstr "Endereço de e-mail, se disponível"

#: intake/forms.py:107
msgid "City, state, or detention facility"
msgstr "Cidade, estado ou centro de detenção"

#: intake/forms.py:115
msgid "Court name or city, if known"
msgstr "Nome do tribunal ou cidade, se souber"

#: intake/forms.py:121
msgid "Example: A123456789"
msgstr "Exemplo: A123456789"

#: intake/forms.py:131
msgid "Describe why returning would be unsafe for you."
msgstr "Descreva por que retornar seria inseguro para você."

#: intake/forms.py:139
msgid "Describe any past harm, threats, or persecution."
msgstr "Descreva quaisquer danos, ameaças ou perseguições anteriores."

#: intake/forms.py:148
msgid "List countries traveled through and whether you applied for asylum."
msgstr "Liste os países pelos quais viajou e se solicitou asilo."

#: intake/forms.py:164
msgid "This information is required."
msgstr "Esta informação é obrigatória."

