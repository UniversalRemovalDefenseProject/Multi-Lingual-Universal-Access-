#: intake/forms.py:10
msgid ""
"I understand that submitting this form does not create an attorney-client "
"relationship."
msgstr ""
"Entiendo que el envío de este formulario no crea una relación abogado-cliente."

#: intake/forms.py:15
msgid "Please acknowledge this notice before submitting your intake."
msgstr "Por favor, confirme este aviso antes de enviar su solicitud."

#: intake/forms.py:41
msgid "Full name"
msgstr "Nombre completo"

#: intake/forms.py:42
msgid "Date of birth"
msgstr "Fecha de nacimiento"

#: intake/forms.py:43
msgid "Country of origin"
msgstr "País de origen"

#: intake/forms.py:44
msgid "Preferred language"
msgstr "Idioma preferido"

#: intake/forms.py:45
msgid "Phone number"
msgstr "Número de teléfono"

#: intake/forms.py:46
msgid "Email address"
msgstr "Correo electrónico"

#: intake/forms.py:47
msgid "Current city or location"
msgstr "Ciudad o lugar actual"

#: intake/forms.py:48
msgid "Currently detained"
msgstr "Actualmente detenido/a"

#: intake/forms.py:49
msgid "Immigration court"
msgstr "Corte de inmigración"

#: intake/forms.py:50
msgid "A-number"
msgstr "Número A"

#: intake/forms.py:51
msgid "Next hearing date"
msgstr "Fecha de la próxima audiencia"

#: intake/forms.py:52
msgid "Reason for fearing return"
msgstr "Razón por la que teme regresar"

#: intake/forms.py:53
msgid "Past harm or persecution"
msgstr "Daño o persecución pasada"

#: intake/forms.py:55
msgid "Countries traveled through and asylum applications"
msgstr "Países por los que viajó y solicitudes de asilo"

#: intake/forms.py:57
msgid "Family members included"
msgstr "Familiares incluidos"

#: intake/forms.py:63
msgid "Enter your full name"
msgstr "Ingrese su nombre completo"

#: intake/forms.py:77
msgid "Country where you are from"
msgstr "País del que proviene"

#: intake/forms.py:84
msgid "Language you prefer for communication"
msgstr "Idioma que prefiere para comunicarse"

#: intake/forms.py:91
msgid "Best phone number to reach you"
msgstr "Mejor número de teléfono para contactarle"

#: intake/forms.py:99
msgid "Email address, if available"
msgstr "Correo electrónico, si está disponible"

#: intake/forms.py:107
msgid "City, state, or detention facility"
msgstr "Ciudad, estado o centro de detención"

#: intake/forms.py:115
msgid "Court name or city, if known"
msgstr "Nombre de la corte o ciudad, si lo sabe"

#: intake/forms.py:121
msgid "Example: A123456789"
msgstr "Ejemplo: A123456789"

#: intake/forms.py:131
msgid "Describe why returning would be unsafe for you."
msgstr "Describa por qué regresar sería peligroso para usted."

#: intake/forms.py:139
msgid "Describe any past harm, threats, or persecution."
msgstr "Describa cualquier daño, amenaza o persecución pasada."

#: intake/forms.py:148
msgid "List countries traveled through and whether you applied for asylum."
msgstr "Liste los países por los que viajó y si solicitó asilo en ellos."

#: intake/forms.py:164
msgid "This information is required."
msgstr "Esta información es obligatoria."

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:30
