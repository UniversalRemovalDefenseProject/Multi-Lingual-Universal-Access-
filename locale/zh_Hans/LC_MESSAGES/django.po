#: intake/forms.py:10
msgid ""
"I understand that submitting this form does not create an attorney-client "
"relationship."
msgstr ""
"我理解提交此表格不会建立律师-当事人关系。"

#: intake/forms.py:15
msgid "Please acknowledge this notice before submitting your intake."
msgstr "请在提交申请前确认此通知。"

#: intake/forms.py:41
msgid "Full name"
msgstr "全名"

#: intake/forms.py:42
msgid "Date of birth"
msgstr "出生日期"

#: intake/forms.py:43
msgid "Country of origin"
msgstr "原籍国"

#: intake/forms.py:44
