msgstr "首选语言"

#: intake/forms.py:45
msgid "Phone number"
msgstr "电话号码"

#: intake/forms.py:46
msgid "Email address"
msgstr "电子邮件地址"

#: intake/forms.py:47
msgid "Current city or location"
msgstr "当前城市或位置"

#: intake/forms.py:48
msgid "Currently detained"
msgstr "目前被拘留"

#: intake/forms.py:49
msgid "Immigration court"
msgstr "移民法庭"

#: intake/forms.py:50
msgid "A-number"
msgstr "A号码"

#: intake/forms.py:51
msgid "Next hearing date"
msgstr "下次听证日期"

#: intake/forms.py:52
msgid "Reason for fearing return"
msgstr "害怕返回的原因"

#: intake/forms.py:53
msgid "Past harm or persecution"
msgstr "过去的伤害或迫害"

#: intake/forms.py:55
msgid "Countries traveled through and asylum applications"
msgstr "途经国家及庇护申请情况"

#: intake/forms.py:57
msgid "Family members included"
msgstr "包含的家庭成员"

#: intake/forms.py:63
msgid "Enter your full name"
msgstr "请输入您的全名"

#: intake/forms.py:77
msgid "Country where you are from"
msgstr "您来自的国家"

#: intake/forms.py:84
msgid "Language you prefer for communication"
msgstr "您偏好的沟通语言"

#: intake/forms.py:91
msgid "Best phone number to reach you"
msgstr "联系您的最佳电话号码"

#: intake/forms.py:99
msgid "Email address, if available"
msgstr "电子邮件地址（如有）"

#: intake/forms.py:107
msgid "City, state, or detention facility"
msgstr "城市、州或拘留设施"

#: intake/forms.py:115
msgid "Court name or city, if known"
msgstr "法庭名称或城市（如已知）"

#: intake/forms.py:121
msgid "Example: A123456789"
msgstr "示例：A123456789"

#: intake/forms.py:131
msgid "Describe why returning would be unsafe for you."
msgstr "请描述为什么返回对您来说是不安全的。"

#: intake/forms.py:139
msgid "Describe any past harm, threats, or persecution."
msgstr "请描述您经历过的任何伤害、威胁或迫害。"

#: intake/forms.py:148
msgid "List countries traveled through and whether you applied for asylum."
msgstr "请列出您途经的国家以及是否在那里申请了庇护。"

#: intake/forms.py:164
msgid "This information is required."
msgstr "此信息为必填项。"

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:30
#: intake/models.py:37
