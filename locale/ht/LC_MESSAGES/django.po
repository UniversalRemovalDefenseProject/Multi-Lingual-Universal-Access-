#: intake/forms.py:10
msgid ""
"I understand that submitting this form does not create an attorney-client "
"relationship."
msgstr ""
"Mwen konprann ke soumèt fòm sa a pa kreye yon relasyon avoka-kliyan."

#: intake/forms.py:15
msgid "Please acknowledge this notice before submitting your intake."
msgstr "Tanpri konfime avi sa a anvan ou soumèt demann ou."

#: intake/forms.py:41
msgid "Full name"
msgstr "Non konplè"

#: intake/forms.py:42
msgid "Date of birth"
msgstr "Dat nesans"

#: intake/forms.py:43
msgid "Country of origin"
msgstr "Peyi orijin"

#: intake/forms.py:44
msgid "Preferred language"
msgstr "Lang prefere"

#: intake/forms.py:45
msgid "Phone number"
msgstr "Nimewo telefòn"

#: intake/forms.py:46
msgid "Email address"
msgstr "Adrès imèl"

#: intake/forms.py:47
msgid "Current city or location"
msgstr "Vil oswa kote aktyèl"

#: intake/forms.py:48
msgid "Currently detained"
msgstr "Aktyèlman detni"

#: intake/forms.py:49
msgid "Immigration court"
msgstr "Tribinal imigrasyon"

#: intake/forms.py:50
msgid "A-number"
msgstr "Nimewo A"

#: intake/forms.py:51
msgid "Next hearing date"
msgstr "Dat pwochen odyans"

#: intake/forms.py:52
msgid "Reason for fearing return"
msgstr "Rezon pou pè retounen"

#: intake/forms.py:53
msgid "Past harm or persecution"
msgstr "Dòmaj oswa pèsekisyon nan pase"

#: intake/forms.py:55
msgid "Countries traveled through and asylum applications"
msgstr "Peyi ou te vwayaje atravè ak demann azil"

#: intake/forms.py:57
msgid "Family members included"
msgstr "Manm fanmi enkli"

#: intake/forms.py:63
msgid "Enter your full name"
msgstr "Antre non konplè ou"

#: intake/forms.py:77
msgid "Country where you are from"
msgstr "Peyi kote ou soti"

#: intake/forms.py:84
msgid "Language you prefer for communication"
msgstr "Lang ou prefere pou kominikasyon"

#: intake/forms.py:91
msgid "Best phone number to reach you"
msgstr "Pi bon nimewo telefòn pou kontakte ou"

#: intake/forms.py:99
msgid "Email address, if available"
msgstr "Adrès imèl, si disponib"

#: intake/forms.py:107
msgid "City, state, or detention facility"
msgstr "Vil, eta, oswa sant detansyon"

#: intake/forms.py:115
msgid "Court name or city, if known"
msgstr "Non tribinal oswa vil, si li konnen"

#: intake/forms.py:121
msgid "Example: A123456789"
msgstr "Egzanp: A123456789"

#: intake/forms.py:131
msgid "Describe why returning would be unsafe for you."
msgstr "Dekri poukisa retounen ta danjere pou ou."

#: intake/forms.py:139
msgid "Describe any past harm, threats, or persecution."
msgstr "Dekri nenpòt dòmaj, menas, oswa pèsekisyon nan pase."

#: intake/forms.py:148
msgid "List countries traveled through and whether you applied for asylum."
msgstr "Liste peyi ou te vwayaje atravè ak si ou te mande azil."

#: intake/forms.py:164
msgid "This information is required."
msgstr "Enfòmasyon sa a obligatwa."

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:30
#: intake/models.py:37
msgid "Language used while completing the intake form."
msgstr "Lang itilize pandan yo ranpli fòm nan."

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:41
#: intake/migrations/0005_intakesubmission_language_translation_fields.py:51
#: intake/migrations/0005_intakesubmission_language_translation_fields.py:61
#: intake/models.py:52 intake/models.py:56 intake/models.py:60
msgid "Staff translation only. The original response is preserved separately."
msgstr "Tradiksyon pèsonèl sèlman. Repons orijinal la konsève separeman."

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:83
#: intake/models.py:66
msgid "Language of any staff-entered translated responses."
msgstr "Lang repons tradui pèsonèl yo te antre."

