#: intake/forms.py:10
msgid ""
"I understand that submitting this form does not create an attorney-client "
"relationship."
msgstr ""
"Je comprends que la soumission de ce formulaire ne crée pas de relation avocat-client."

#: intake/forms.py:15
msgid "Please acknowledge this notice before submitting your intake."
msgstr "Veuillez confirmer cet avis avant de soumettre votre demande."

#: intake/forms.py:41
msgid "Full name"
msgstr "Nom complet"

#: intake/forms.py:42
