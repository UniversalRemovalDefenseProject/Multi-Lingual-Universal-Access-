msgstr "Pays dont vous êtes originaire"

#: intake/forms.py:84
msgid "Language you prefer for communication"
msgstr "Langue que vous préférez pour la communication"

#: intake/forms.py:91
msgid "Best phone number to reach you"
msgstr "Meilleur numéro de téléphone pour vous joindre"

#: intake/forms.py:99
msgid "Email address, if available"
msgstr "Adresse e-mail, si disponible"

#: intake/forms.py:107
msgid "City, state, or detention facility"
msgstr "Ville, état ou centre de détention"

#: intake/forms.py:115
msgid "Court name or city, if known"
msgstr "Nom du tribunal ou ville, si connu"

#: intake/forms.py:121
msgid "Example: A123456789"
msgstr "Exemple : A123456789"

#: intake/forms.py:131
msgid "Describe why returning would be unsafe for you."
msgstr "Décrivez pourquoi le retour serait dangereux pour vous."

#: intake/forms.py:139
msgid "Describe any past harm, threats, or persecution."
msgstr "Décrivez tout préjudice, menace ou persécution passée."

#: intake/forms.py:148
msgid "List countries traveled through and whether you applied for asylum."
msgstr "Listez les pays traversés et si vous avez demandé l'asile."

#: intake/forms.py:164
msgid "This information is required."
msgstr "Cette information est obligatoire."

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:30
