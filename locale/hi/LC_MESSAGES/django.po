msgid "English"
msgstr "अंग्रेज़ी"

#: intake/models.py:8 urdp/settings.py:114
msgid "Spanish"
msgstr "स्पेनिश"

#: intake/models.py:9 urdp/settings.py:115
msgid "French"
msgstr "फ्रेंच"

