#: intake/forms.py:10
msgid ""
"I understand that submitting this form does not create an attorney-client "
"relationship."
msgstr ""
"मैं समझता/समझती हूँ कि इस फ़ॉर्म को जमा करने से वकील-मुवक्किल संबंध नहीं बनता।"

#: intake/forms.py:15
msgid "Please acknowledge this notice before submitting your intake."
msgstr "कृपया अपना आवेदन जमा करने से पहले इस सूचना को स्वीकार करें।"

#: intake/forms.py:41
msgid "Full name"
msgstr "पूरा नाम"

#: intake/forms.py:42
msgid "Date of birth"
msgstr "जन्म तिथि"

#: intake/forms.py:43
msgid "Country of origin"
msgstr "मूल देश"

#: intake/forms.py:44
msgid "Preferred language"
msgstr "पसंदीदा भाषा"

#: intake/forms.py:45
msgid "Phone number"
msgstr "फ़ोन नंबर"

#: intake/forms.py:46
msgid "Email address"
msgstr "ईमेल पता"

#: intake/forms.py:47
msgid "Current city or location"
msgstr "वर्तमान शहर या स्थान"

#: intake/forms.py:48
msgid "Currently detained"
msgstr "वर्तमान में हिरासत में"

#: intake/forms.py:49
msgid "Immigration court"
msgstr "आव्रजन न्यायालय"

#: intake/forms.py:50
msgid "A-number"
msgstr "A-नंबर"

#: intake/forms.py:51
msgid "Next hearing date"
msgstr "अगली सुनवाई की तारीख"

#: intake/forms.py:52
msgid "Reason for fearing return"
msgstr "वापसी से डरने का कारण"

#: intake/forms.py:53
msgid "Past harm or persecution"
msgstr "पिछला नुकसान या उत्पीड़न"

#: intake/forms.py:55
msgid "Countries traveled through and asylum applications"
msgstr "जिन देशों से होकर गए और शरण आवेदन"

#: intake/forms.py:57
msgid "Family members included"
msgstr "शामिल परिवार के सदस्य"

#: intake/forms.py:63
msgid "Enter your full name"
msgstr "अपना पूरा नाम दर्ज करें"

#: intake/forms.py:77
msgid "Country where you are from"
msgstr "वह देश जहाँ से आप हैं"

#: intake/forms.py:84
msgid "Language you prefer for communication"
msgstr "संचार के लिए आपकी पसंदीदा भाषा"

#: intake/forms.py:91
msgid "Best phone number to reach you"
msgstr "आप तक पहुँचने के लिए सबसे अच्छा फ़ोन नंबर"

#: intake/forms.py:99
msgid "Email address, if available"
msgstr "ईमेल पता, यदि उपलब्ध हो"

#: intake/forms.py:107
msgid "City, state, or detention facility"
msgstr "शहर, राज्य, या हिरासत सुविधा"

#: intake/forms.py:115
msgid "Court name or city, if known"
msgstr "न्यायालय का नाम या शहर, यदि ज्ञात हो"

#: intake/forms.py:121
msgid "Example: A123456789"
msgstr "उदाहरण: A123456789"

#: intake/forms.py:131
msgid "Describe why returning would be unsafe for you."
msgstr "बताएं कि वापस जाना आपके लिए क्यों असुरक्षित होगा।"

#: intake/forms.py:139
msgid "Describe any past harm, threats, or persecution."
msgstr "किसी भी पिछले नुकसान, धमकी या उत्पीड़न का वर्णन करें।"

#: intake/forms.py:148
msgid "List countries traveled through and whether you applied for asylum."
msgstr "जिन देशों से गुजरे उनकी सूची बनाएं और बताएं कि क्या आपने शरण के लिए आवेदन किया।"

#: intake/forms.py:164
msgid "This information is required."
msgstr "यह जानकारी आवश्यक है।"

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:30
#: intake/models.py:37
msgid "Language used while completing the intake form."
msgstr "फ़ॉर्म भरते समय उपयोग की गई भाषा।"

#: intake/migrations/0005_intakesubmission_language_translation_fields.py:41
#: intake/migrations/0005_intakesubmission_language_translation_fields.py:51
#: intake/migrations/0005_intakesubmission_language_translation_fields.py:61
#: intake/models.py:52 intake/models.py:56 intake/models.py:60
